{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lm-eval settings",
  "type": "object",
  "properties": {
    "tokenizer": {"type": "string"},
    "num_concurrent": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "metric": {"type": "string", "pattern": "^[A-Za-z0-9_-]+,[A-Za-z0-9_-]+$"},
          "num_fewshot": {"type": "integer", "minimum": 0},
          "limit": {"type": "integer", "minimum": 1}
        },
        "required": ["name", "metric", "num_fewshot", "limit"],
        "additionalProperties": false
      }
    }
  },
  "required": ["tokenizer", "num_concurrent", "seed", "tasks"],
  "additionalProperties": false
}
