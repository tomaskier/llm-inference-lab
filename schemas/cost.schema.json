{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference GPU price",
  "type": "object",
  "properties": {
    "gpu": {"type": "string"},
    "provider": {"type": "string"},
    "price_per_hour_usd": {"type": "number", "exclusiveMinimum": 0},
    "checked_on": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        {"type": "null"}
      ]
    }
  },
  "required": ["gpu", "provider", "price_per_hour_usd", "checked_on"],
  "additionalProperties": false
}
